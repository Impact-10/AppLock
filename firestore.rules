rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{adminId}/users/{userUid} {
      allow read, write: if request.auth != null && (request.auth.uid == adminId || request.auth.uid == userUid);
    }
    match /userProfiles/{userUid} {
      allow read: if request.auth != null && (request.auth.uid == userUid);
      allow write: if request.auth != null && request.auth.uid == userUid; // limited updates by app client
    }
  }
}
